{
  "name": "@forestoval/live-lettering",
  "private": true,
  "version": "0.1.0",
  "description": "Live lettering editor for the BC crest family: the v5 engine, its bundled faces, and badge presets built from the shared primitives.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./svg": "./src/svg.ts",
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
