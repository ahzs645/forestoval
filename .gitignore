# Only the three source folders are tracked; the loose review exports and zips
# at the top level stay local.
/*
!/.gitignore
!/.github/
!/README.md
!/requirements.txt
!/shared-primitives/
!/bc-ministry-primitives-v5/
!/airtanker-operations/

# Font files stay local, except the Kabel Black OTF the tree oval uses, which is
# committed for now (see bc-ministry-primitives-v5/docs/kabel-black.md).
/bc-ministry-primitives-v5/fonts/*.otf
/bc-ministry-primitives-v5/fonts/*.ttf
!/bc-ministry-primitives-v5/fonts/Kabel-Black.otf

node_modules/
dist/
__pycache__/
.DS_Store

# Build and test outputs: `python build.py` writes the standalone studio (the
# site build publishes it at studio/); the browser tests write to tests/output/;
# `extract_primitives.py --theme` writes recoloured copies to themes/.
/bc-ministry-primitives-v5/bc-ministry-primitives-v5.html
/bc-ministry-primitives-v5/tests/output/
/shared-primitives/site/tests/output/
/shared-primitives/themes/
